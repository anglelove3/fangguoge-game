      "h": 0.08,
      "lines": [
        {
          "speaker": "",
          "text": "便利贴上写着「记得交电费」，字是自己的，看着有点陌生。"
        },
        {
          "speaker": "我",
          "text": "（「记得」这两个字，好像永远写给自己看。）"
        }
      ]
    },
    {
      "id": "noodles",
      "x": 0.76,
      "y": 0.18,
      "w": 0.14,
      "h": 0.10,
      "lines": [
        {
          "speaker": "",
          "text": "架子上摞着两桶泡面。红烧牛肉，香辣。"
        },
        {
          "speaker": "我",
          "text": "（夜宵的库存，永远比复习进度可靠。）"
        }
      ]
    }
