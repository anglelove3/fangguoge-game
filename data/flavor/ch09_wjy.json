      "h": 0.115,
      "lines": [
        {
          "speaker": "",
          "text": "茶壶是那种沉的陶壶，倒水的时候不出声。"
        },
        {
          "speaker": "我",
          "text": "（长辈们喜欢这种壶。说是有手感。）"
        }
      ]
    },
    {
      "id": "empty_chair",
      "x": 0.055,
      "y": 0.545,
