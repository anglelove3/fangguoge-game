      "lines": [
        {
          "speaker": "",
          "text": "窗外的树被风翻着，叶子亮一面、暗一面。"
        },
        {
          "speaker": "我",
          "text": "（外面天气这么好。你却在这屋里，坐了一下午。）"
        }
      ]
    },
    {
      "id": "mug_steam",
      "x": 0.62,
      "y": 0.64,
      "w": 0.09,
      "h": 0.19,
      "lines": [
        {
          "speaker": "",
          "text": "咖啡凉了一半，热气还在慢悠悠地往上冒。"
        },
        {
          "speaker": "我",
          "text": "（下午冲的。现在都什么点了。）"
        }
      ]
    },
    {
      "id": "monitor_glow",
      "x": 0.80,
      "y": 0.28,
      "w": 0.19,
      "h": 0.38,
      "lines": [
        {
          "speaker": "",
          "text": "屏幕的光在桌面上铺了蓝蓝的一片。"
        },
        {
          "speaker": "我",
          "text": "（跑不动就是跑不动。盯着它看，它也不会变出结果。）"
        }
      ]
    }
  ]
}
