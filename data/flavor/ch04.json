      "lines": [
        {
          "speaker": "",
          "text": "窗外的城市还亮着几盏灯。这个点醒着的人，比你以为的多。"
        },
        {
          "speaker": "我",
          "text": "（她不在这任何一盏下面。）"
        }
      ]
    },
    {
      "id": "photo_echo",
      "x": 0.5,
      "y": 0.28,
      "w": 0.14,
      "h": 0.19,
      "lines": [
        {
          "speaker": "我",
          "text": "（柜门上的照片，凌晨看是另一个颜色。）"
        },
        {
          "speaker": "我",
          "text": "（照片里的人都在笑。笑得离现在很远。）"
        }
      ]
    },
    {
      "id": "noodles_echo",
      "x": 0.68,
      "y": 0.19,
      "w": 0.12,
      "h": 0.16,
      "lines": [
        {
          "speaker": "",
          "text": "泡面还剩两桶。凌晨一点半，它们的保质期显得特别长。"
        },
        {
          "speaker": "我",
          "text": "（今天没胃口。）"
        }
      ]
    }
  ]
}
