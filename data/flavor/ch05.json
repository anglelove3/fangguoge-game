{
  "spots": [
    {
      "id": "phone",
      "x": 0.505,
      "y": 0.625,
      "w": 0.075,
      "h": 0.07,
      "lines": [
        {
          "speaker": "",
          "text": "手机就扔在被子上，屏幕朝上，一直没再亮。"
        },
        {
          "speaker": "我",
          "text": "（最后一条是我发的。发出去之后，房间安静得能听见水管。）"
        }
      ]
    },
    {
      "id": "lamp",
      "x": 0.405,
      "y": 0.375,
      "w": 0.065,
      "h": 0.085,
      "lines": [
        {
          "speaker": "",
          "text": "床头那盏小灯的光只够照亮枕头一角。"
        },
        {
          "speaker": "我",
          "text": "（够用了。今晚也不想看清什么。）"
        }
      ]
    },
    {
      "id": "slippers",
      "x": 0.625,
      "y": 0.85,
      "w": 0.08,
      "h": 0.1,
      "lines": [
        {
          "speaker": "",
          "text": "拖鞋一只朝里，一只朝外，像有人刚下床。"
        },
        {
          "speaker": "我",
          "text": "（其实是我自己踢的。看着还是像。）"
        }
      ]
    },
    {
      "id": "clothes",
      "x": 0.8,
      "y": 0.2,
      "w": 0.095,
      "h": 0.2,
      "lines": [
        {
          "speaker": "",
          "text": "衣柜里那件灰外套还挂着，她说过这个颜色显老。"
        },
        {
          "speaker": "我",
          "text": "（后来我一直穿。也没谁再提这件事。）"
        }
      ]
    }
  ]
}